# DeployCloud build context exclusions
# One pattern per line. Comments must start at the beginning of a line
# (inline comments are not supported and cause "syntax error in pattern").

# Dependencies are installed by npm ci inside the image; never send them
node_modules/

# VCS and editor metadata
.git/
.gitignore
.vscode/
.idea/

# Logs and npm cache
npm-debug.log*
*.log
.npm/

# Vercel-local config (this project deploys to DeployCloud only)
.vercel/
vercel.json

# OS junk files
.DS_Store
Thumbs.db
